# Public URL where the portal is reachable (no trailing slash)
BASE_URL=https://tools.yourdomain.com

# HTTP Basic Auth — single credential (leave blank to disable auth entirely)
AUTH_USER=admin
AUTH_PASS=changeme

# Multi-user alternative (takes precedence over AUTH_USER/AUTH_PASS):
# AUTH_USERS=alice:pass1,bob:pass2

# Max upload size per request, in bytes (default 100 MB)
MAX_UPLOAD_BYTES=104857600

# Request/access logging. Keep OFF so the platform never records activity.
# Set to true only for local debugging.
ACCESS_LOG=false
